# Dependencies
node_modules/
frontend/node_modules/

# Next.js
# Unanchored so it also catches the repo-root .next/ that appears when next is
# run from here rather than frontend/ — it only ever holds trace files.
.next/
frontend/out/

# Python
__pycache__/
*.pyc
.venv/

# uv
.python-version

# Environment
.env
.env.local
.env*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/

# Data and cache (root level only, not frontend/src/data/)
/data/
*.vtt

